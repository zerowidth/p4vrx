CONFIG_IDF_TARGET="esp32p4"
# The Waveshare board carries a rev v3.2 P4.
CONFIG_ESP32P4_REV_MIN_300=y

# Boot log and panics on UART0 (GPIO 37/38), the CH343 USB-C; the console also answers there.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# vTaskDelay(1) in the USB write loop should be 1 ms.
CONFIG_FREERTOS_HZ=1000
# The console runs commands on the main task, and a PARLIO receive puts 16 bytes per 4 KB of buffer on its stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# I/Q captures live in the in-package PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# The decoder's per-sample loop needs optimized code.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The H.264 encoder writes its whole input back from the cache inside a critical section, which held
# core 0 for about 5 ms per frame; in 32 KB chunks the decoder's drawing task gets in between.
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS=y
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS_MAX_LEN=0x8000

# Per-task run time for the `cpu` command.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

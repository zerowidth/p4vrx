# SPDX-License-Identifier: MIT
CONFIG_IDF_TARGET="esp32p4"
# The Waveshare board carries a rev v3.2 P4.
CONFIG_ESP32P4_REV_MIN_300=y

# Boot log and panics on UART0 (GPIO 37/38), the CH343 USB-C; the console also answers there.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# vTaskDelay(1) in the USB write loop should be 1 ms.
CONFIG_FREERTOS_HZ=1000
# The console runs commands on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
